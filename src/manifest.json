{
    "manifest_version": 3,
    "name": "__MSG_ext_name__",
    "short_name": "__MSG_ext_short_name__",
    "description": "__MSG_ext_description__",
    "version": "1.0.0",
    "default_locale": "en",
    "minimum_chrome_version": "123",
    "homepage_url": "https://github.com/coddytech/coddy-focus",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128-padded.png"
    },
    "action": {
        "default_title": "__MSG_ext_short_name__",
        "default_popup": "pages/popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "options_ui": {
        "page": "pages/options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "background/worker.js",
        "type": "module"
    },
    "permissions": ["storage", "alarms", "idle", "declarativeNetRequest", "scripting", "activeTab", "favicon"],
    "optional_host_permissions": ["*://*/*"],
    "web_accessible_resources": [
        {
            "resources": ["pages/blocked.html"],
            "matches": ["<all_urls>"]
        }
    ],
    "content_security_policy": {
        "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    },
    "incognito": "spanning"
}
